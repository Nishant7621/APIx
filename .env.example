# ==========================================
# Airline Price Index (APIx) Environment Config
# ==========================================

# Database Configuration (PostgreSQL with psycopg 3)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apix_db

# Fallback: Set to true to automatically fallback to local SQLite (apix_local.db)
# if PostgreSQL is not reachable during local development or offline testing.
ALLOW_SQLITE_FALLBACK=true

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Fixed Pilot Rules (30-day collection period methodology)
PILOT_ROUTES=DEL-BOM,DEL-BLR,BOM-BLR,DEL-CCU,BLR-HYD,MAA-DEL
PILOT_WINDOWS=1,7,15,30,45
PILOT_CABIN=ECONOMY
PILOT_CURRENCY=INR
PILOT_PASSENGERS=1

# Collector Configuration
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=1
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36 (APIx Research Bot/1.0; Local Education Project)"

# Safety & Automation Mode: STRICTLY MANUAL
# Prevents any automated recurring background collection.
AUTOMATED_SCRAPING_ENABLED=false
COLLECTION_MODE=MANUAL_ONLY
